{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "audio",
    "transcript",
    "name"
  ],
  "properties": {
    "audio": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "transcript": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "language": {
      "type": "string",
      "enum": [
        "auto",
        "chinese",
        "english",
        "japanese",
        "korean",
        "german",
        "french",
        "russian",
        "portuguese",
        "spanish",
        "italian"
      ]
    }
  },
  "additionalProperties": false
}
