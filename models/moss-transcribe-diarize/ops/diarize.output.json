{"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "properties": {"segments": {"type": "array", "items": {"type": "object", "properties": {"start": {"type": "number", "minimum": 0, "maximum": 86400}, "end": {"type": "number", "minimum": 0, "maximum": 86400}, "speaker": {"type": "string"}, "text": {"type": "string"}}, "required": ["start", "end", "speaker", "text"], "additionalProperties": false}, "minItems": 0, "maxItems": 100000, "description": "Segments in order, as the model wrote them: start and end in seconds, speaker label, text."}, "speakers": {"type": "array", "items": {"type": "string"}, "description": "Speaker labels in order of first appearance."}, "rttm": {"type": "string", "description": "The segments in RTTM format."}, "transcript": {"type": "string", "description": "The model's raw transcript ([start][Sxx]text[end] \u2026)."}, "truncated": {"type": "boolean", "description": "True when max_new_tokens ran out before the model finished: the transcript stops early. Raise max_new_tokens and run again."}}, "required": ["segments", "speakers", "rttm", "transcript", "truncated"], "additionalProperties": false}