{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "video": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "x-arsenal-file": {
        "accept": [
          "video/*"
        ]
      },
      "x-arsenal-control": "video-picker"
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false,
        "x-arsenal-file": {
          "accept": [
            "image/png",
            "image/jpeg"
          ]
        },
        "x-arsenal-control": "image-picker"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "factor": {
      "type": "integer",
      "minimum": 2,
      "maximum": 16,
      "default": 2
    },
    "target_fps": {
      "type": "number",
      "minimum": 1,
      "maximum": 240
    },
    "t": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 1,
      "maxItems": 16
    }
  },
  "required": [],
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "frames"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "video"
            ]
          },
          {
            "required": [
              "factor"
            ]
          },
          {
            "required": [
              "target_fps"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "video"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "frames"
            ]
          },
          {
            "required": [
              "t"
            ]
          },
          {
            "required": [
              "factor",
              "target_fps"
            ]
          }
        ]
      }
    }
  ]
}
