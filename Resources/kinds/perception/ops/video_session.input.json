{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "create",
        "close"
      ]
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "video": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "x-arsenal-file": {
        "accept": [
          "video/*"
        ]
      },
      "x-arsenal-control": "video-picker"
    }
  },
  "required": [
    "action"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "create"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "video"
        ]
      },
      "else": {
        "required": [
          "session_id"
        ]
      }
    }
  ]
}
