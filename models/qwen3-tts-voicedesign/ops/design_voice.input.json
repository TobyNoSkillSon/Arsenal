{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "description"
  ],
  "properties": {
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "preview_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000
    },
    "language": {
      "type": "string",
      "enum": [
        "auto",
        "chinese",
        "english",
        "japanese",
        "korean",
        "german",
        "french",
        "russian",
        "portuguese",
        "spanish",
        "italian"
      ]
    },
    "out_dir": {
      "type": "string"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "top_p": {
      "type": "number",
      "maximum": 1,
      "minimum": 1e-06
    },
    "top_k": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "repetition_penalty": {
      "type": "number",
      "maximum": 2,
      "minimum": 0.01
    }
  },
  "additionalProperties": false
}
