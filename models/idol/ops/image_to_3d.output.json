{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "mime": {
            "type": "string",
            "enum": [
              "application/x-ply",
              "image/png"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967296
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "What this file is, for display (\"Vocals\", \"Depth map\")."
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535,
            "description": "Display position among the files; lower first."
          }
        },
        "required": [
          "id",
          "path",
          "mime"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 2
    },
    "gaussians": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576,
      "description": "Gaussians in the PLY."
    },
    "camera": {
      "type": "object",
      "description": "The camera IDOL estimates for the picture: yaw and pitch in radians, distance, vertical field of view in degrees.",
      "properties": {
        "yaw": {
          "type": "number"
        },
        "pitch": {
          "type": "number"
        },
        "radius": {
          "type": "number"
        },
        "fov": {
          "type": "number"
        }
      },
      "required": [
        "yaw",
        "pitch",
        "radius",
        "fov"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "files",
    "gaussians",
    "camera"
  ],
  "additionalProperties": false
}
