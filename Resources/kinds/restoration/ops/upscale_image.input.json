{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "x-arsenal-file": {
        "accept": [
          "image/png",
          "image/jpeg"
        ]
      },
      "x-arsenal-control": "image-picker"
    },
    "scale": {
      "type": "integer",
      "enum": [
        2,
        4
      ]
    },
    "target_height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16384
    },
    "prompt": {
      "type": "string",
      "maxLength": 10000
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  },
  "required": [
    "image"
  ],
  "additionalProperties": false
}
