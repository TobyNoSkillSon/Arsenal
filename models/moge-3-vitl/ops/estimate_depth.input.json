{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "x-arsenal-file": {
        "accept": [
          "image/png",
          "image/jpeg"
        ]
      },
      "x-arsenal-control": "image-picker"
    },
    "mode": {
      "type": "string",
      "const": "metric"
    },
    "points": {
      "type": "boolean"
    },
    "intrinsics": {
      "type": "boolean"
    },
    "focal_length": {
      "type": "number",
      "minimum": 0.001,
      "maximum": 100000
    },
    "normals": {
      "type": "boolean"
    },
    "resolution_level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9,
      "default": 9
    },
    "refine_steps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16,
      "default": 3
    },
    "apply_mask": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "image"
  ],
  "additionalProperties": false
}
