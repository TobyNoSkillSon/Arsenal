{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "audio": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "mode": {
      "type": "string",
      "enum": [
        "denoise"
      ],
      "default": "denoise"
    },
    "one_time_decode_length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60,
      "default": 20,
      "description": "Longest clip, in seconds, cleaned in one pass; longer clips are cleaned in windows."
    },
    "decode_window": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 4,
      "description": "Window length in seconds for clips longer than one_time_decode_length; windows overlap by a quarter."
    },
    "out_dir": {
      "type": "string",
      "minLength": 1
    },
    "stream": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "audio"
  ],
  "additionalProperties": false
}
