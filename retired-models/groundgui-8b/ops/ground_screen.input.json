{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "x-arsenal-file": {
        "accept": [
          "image/png",
          "image/jpeg"
        ]
      },
      "x-arsenal-control": "image-picker"
    },
    "instruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "platform": {
      "type": "string",
      "enum": [
        "desktop",
        "web",
        "mobile"
      ],
      "default": "desktop"
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024,
      "default": 256
    }
  },
  "required": [
    "image",
    "instruction"
  ],
  "additionalProperties": false
}
