{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 120,
      "default": 5
    },
    "steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 8
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "guidance": {
      "type": "number",
      "minimum": 0,
      "maximum": 20,
      "default": 1
    },
    "negative_prompt": {
      "type": "string"
    },
    "out_dir": {
      "type": "string",
      "minLength": 1
    },
    "stream": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "prompt"
  ],
  "additionalProperties": false
}
