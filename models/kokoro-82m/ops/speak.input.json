{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "text"
  ],
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000,
      "description": "Arsenal request cap; models tokenize/chunk separately. Not a vendor quality or context-length guarantee."
    },
    "voice": {
      "type": "string"
    },
    "speed": {
      "type": "number",
      "minimum": 0.25,
      "maximum": 4
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "stream": {
      "type": "boolean"
    },
    "out_dir": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
