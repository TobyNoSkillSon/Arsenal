{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "input": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "text"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32768
              }
            },
            "required": [
              "type",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "image"
                ]
              },
              "image": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "path"
                ],
                "additionalProperties": false,
                "x-arsenal-file": {
                  "accept": [
                    "image/png",
                    "image/jpeg"
                  ]
                },
                "x-arsenal-control": "image-picker"
              }
            },
            "required": [
              "type",
              "image"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1,
      "maxItems": 256
    },
    "normalize": {
      "type": "boolean"
    }
  },
  "required": [
    "input"
  ],
  "additionalProperties": false
}
