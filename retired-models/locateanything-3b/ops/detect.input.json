{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "x-arsenal-file": {
        "accept": [
          "image/png",
          "image/jpeg"
        ]
      },
      "x-arsenal-control": "image-picker"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 512
    },
    "instruction": {
      "type": "string",
      "maxLength": 10000
    },
    "output_mode": {
      "type": "string",
      "enum": [
        "boxes",
        "points"
      ],
      "default": "boxes"
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192,
      "default": 2048
    },
    "phrase": {
      "type": "string",
      "maxLength": 10000
    }
  },
  "required": [
    "image"
  ],
  "additionalProperties": false
}
