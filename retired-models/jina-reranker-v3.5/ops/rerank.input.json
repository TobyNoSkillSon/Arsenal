{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000000
      },
      "minItems": 1,
      "maxItems": 1024
    },
    "top_n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "max_tokens_per_doc": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "return_embeddings": {
      "type": "boolean"
    }
  },
  "required": [
    "query",
    "documents"
  ],
  "additionalProperties": false
}
