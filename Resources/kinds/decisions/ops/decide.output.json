{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "System One response",
  "type": "object",
  "required": [
    "answers",
    "model",
    "usage"
  ],
  "properties": {
    "answers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "noul",
              "choice",
              "score"
            ]
          },
          "noul": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "choice": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "probabilities": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "score": {
            "type": "number"
          },
          "legend": {
            "type": "object"
          }
        }
      }
    },
    "model": {
      "type": "string"
    },
    "usage": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "const": 0
        }
      }
    },
    "bits": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Arsenal worker extra: the precision that answered (Verdict's x-verdict-bits header); dialect routes move it to that header."
    }
  }
}
