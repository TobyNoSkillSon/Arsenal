{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "audio": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "x-arsenal-file": {
        "accept": [
          "audio/*"
        ]
      },
      "x-arsenal-control": "audio-picker"
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32,
      "x-arsenal-control": "language"
    },
    "prompt": {
      "type": "string",
      "maxLength": 32768
    },
    "word_timestamps": {
      "type": "boolean"
    },
    "diarize": {
      "type": "boolean"
    },
    "task": {
      "type": "string",
      "enum": [
        "transcribe",
        "translate"
      ]
    },
    "stream": {
      "type": "boolean"
    }
  },
  "required": [
    "audio"
  ],
  "additionalProperties": false
}
