{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "x-arsenal-file": {
        "accept": [
          "image/png",
          "image/jpeg"
        ]
      },
      "x-arsenal-control": "image-picker"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "resolution": {
      "type": "integer",
      "minimum": 256,
      "maximum": 1536
    },
    "texture_size": {
      "type": "integer",
      "minimum": 256,
      "maximum": 4096
    },
    "simplify": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "image"
  ],
  "additionalProperties": false
}
