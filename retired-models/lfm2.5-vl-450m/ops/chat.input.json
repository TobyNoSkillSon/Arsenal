{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "text"
                          ]
                        },
                        "text": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "text"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "image"
                        },
                        "image": {
                          "type": "object",
                          "properties": {
                            "path": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "path"
                          ],
                          "additionalProperties": false,
                          "x-arsenal-file": {
                            "accept": [
                              "image/png",
                              "image/jpeg"
                            ]
                          },
                          "x-arsenal-control": "image-picker"
                        }
                      },
                      "required": [
                        "type",
                        "image"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "image_url"
                        },
                        "image_url": {
                          "type": "object",
                          "properties": {
                            "url": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "url"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "type",
                        "image_url"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "stream": {
      "type": "boolean"
    }
  },
  "required": [
    "messages"
  ],
  "additionalProperties": false
}
