{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "video": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "x-arsenal-file": {
        "accept": [
          "video/*"
        ]
      },
      "x-arsenal-control": "video-picker"
    },
    "scale": {
      "type": "number",
      "minimum": 1,
      "maximum": 8
    },
    "target_height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "prompt": {
      "type": "string",
      "maxLength": 10000
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  },
  "required": [
    "video"
  ],
  "additionalProperties": false
}
