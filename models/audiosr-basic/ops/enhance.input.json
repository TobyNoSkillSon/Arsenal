{"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "properties": {"audio": {"type": "object", "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 4096}}, "required": ["path"], "additionalProperties": false, "x-arsenal-file": {"accept": ["audio/*"]}, "x-arsenal-control": "audio-picker"}, "steps": {"type": "integer", "minimum": 10, "maximum": 100, "default": 50, "description": "DDIM sampling steps; more is slower. Capped at 100 so a 60 s clip stays well inside the operation's time limit."}, "guidance_scale": {"type": "number", "minimum": 1, "maximum": 10, "default": 3.5, "description": "Classifier-free guidance scale."}, "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295, "default": 42, "description": "Changes the generated high band (and, as in the reference, the input low-pass filter type)."}, "stream": {"type": "boolean", "default": false, "description": "Ignored: the result is one file."}}, "required": ["audio"], "additionalProperties": false}