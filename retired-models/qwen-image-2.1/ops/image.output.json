{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "files",
    "seed",
    "seconds"
  ],
  "properties": {
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "mime",
          "width",
          "height",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "mime": {
            "const": "image/png"
          },
          "alpha": {
            "type": "boolean",
            "description": "True when the PNG keeps transparency (RGBA); opaque images are saved as RGB."
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "seconds": {
      "type": "number",
      "minimum": 0
    }
  }
}
