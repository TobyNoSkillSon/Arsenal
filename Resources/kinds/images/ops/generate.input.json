{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "width": {
      "type": "integer",
      "minimum": 64,
      "maximum": 2048,
      "multipleOf": 16
    },
    "height": {
      "type": "integer",
      "minimum": 64,
      "maximum": 2048,
      "multipleOf": 16
    },
    "resolution": {
      "enum": [
        "512x512",
        "768x768",
        "1024x1024"
      ]
    },
    "steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "guidance": {
      "type": "number",
      "minimum": 0,
      "maximum": 20
    },
    "n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "out_dir": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "prompt"
  ]
}
