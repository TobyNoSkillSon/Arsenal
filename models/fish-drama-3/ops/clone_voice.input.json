{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "audio",
    "transcript",
    "name"
  ],
  "properties": {
    "audio": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "description": "Your own recording of the voice, up to 30 seconds."
    },
    "transcript": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000,
      "description": "Exact words spoken in the recording."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "additionalProperties": false
}
