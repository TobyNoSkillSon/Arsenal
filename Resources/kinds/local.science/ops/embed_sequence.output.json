{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "embedding",
    "dimensions",
    "residues"
  ],
  "properties": {
    "embedding": {
      "type": "array",
      "description": "The sequence embedding: the final-layer residue embeddings averaged over residues (start and end tokens excluded).",
      "items": {
        "type": "number"
      }
    },
    "dimensions": {
      "type": "integer",
      "description": "Length of each embedding."
    },
    "residues": {
      "type": "integer",
      "description": "Number of residues embedded."
    },
    "per_residue": {
      "type": "array",
      "description": "One final-layer embedding per residue, in sequence order (only when per_residue is true).",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    }
  }
}
