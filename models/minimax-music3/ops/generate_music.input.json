{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "lyrics": {
      "type": "string",
      "maxLength": 100000,
      "x-arsenal-control": "lyrics"
    },
    "instrumental": {
      "type": "boolean",
      "default": false
    },
    "duration": {
      "type": "number",
      "minimum": 0.04,
      "maximum": 360,
      "default": 60
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "default": 30
    },
    "guidance": {
      "type": "number",
      "minimum": 0,
      "maximum": 20,
      "default": 1.7
    },
    "batch_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16,
      "default": 1
    },
    "format": {
      "type": "string",
      "enum": [
        "wav",
        "wav32",
        "flac",
        "m4a",
        "alac"
      ],
      "default": "wav"
    },
    "sample_rate": {
      "type": "integer",
      "enum": [
        44100,
        32000
      ],
      "default": 44100
    },
    "include_metadata": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "prompt"
  ],
  "additionalProperties": false
}
